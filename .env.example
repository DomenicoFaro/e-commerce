# ── Sito ──
# URL pubblico del sito (es. https://shophousegiarre.it). Usato per link nelle email, SEO e sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true solo sul sito definitivo, al lancio: permette a Google di indicizzarlo.
SITE_INDEXABLE=false

# ── Supabase (Project Settings → API Keys / Data API) ──
NEXT_PUBLIC_SUPABASE_URL=
# Chiave publishable (sb_publishable_…): pubblica, va bene nel browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chiave secret (sb_secret_…): SOLO server, mai condividerla
SUPABASE_SERVICE_ROLE_KEY=

# ── Pagamenti ed email (Milestone 3, non ancora usati) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
STORE_NOTIFICATION_EMAIL=
